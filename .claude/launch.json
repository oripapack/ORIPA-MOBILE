{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-ui-lab",
      "cwd": "prototypes/next-ui-lab",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "3001"],
      "port": 3001
    },
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "expo-web-uigallery",
      "runtimeExecutable": "env",
      "runtimeArgs": ["EXPO_PUBLIC_DEV_SCREEN=UiGallery", "npx", "expo", "start", "--web", "--port", "8081"],
      "port": 8081
    }
  ]
}
