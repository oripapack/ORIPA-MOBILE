{
  "name": "tcg-mystery-pack",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "build": "npx expo export -p web",
    "start": "node scripts/dev.mjs",
    "dev": "npm start",
    "start:clean": "node scripts/dev.mjs --clear",
    "start:expo-only": "expo start",
    "start:tunnel": "node scripts/dev.mjs --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "npm start",
    "demo:ring": "node scripts/free-pack-ring-port.mjs && vite --config pack-ring-server/vite.config.ts --open",
    "web:export": "npx expo export -p web",
    "prototype:web": "vite --config pack-ring-server/vite.config.ts",
    "marketing:landing": "open marketing/landing/index.html",
    "generate:sfx": "node scripts/generate-pack-sfx.mjs",
    "validate:i18n": "node scripts/validate-i18n-locales.mjs",
    "typecheck:release": "tsc --noEmit -p tsconfig.release.json",
    "audit:release-copy": "node scripts/audit-release-copy.mjs",
    "check:release": "npm run typecheck:release && npm run validate:i18n && npm run audit:release-copy && npx expo-doctor",
    "check:app-store-metadata": "node scripts/check-app-store-metadata.mjs",
    "check:app-store-build": "node scripts/app-store-provenance.mjs",
    "check:app-store-review-notes": "node scripts/app-store-review-notes.mjs",
    "check:app-store-submit": "node scripts/check-app-store-submission.mjs",
    "record:app-store-build": "node scripts/app-store-provenance.mjs --record",
    "render:app-store-review-notes": "node scripts/app-store-review-notes.mjs --render",
    "prepare:app-store-submit": "bash scripts/prepare-app-store-submit.sh",
    "release:ios": "bash scripts/build-production.sh",
    "smoke:live-packs": "node scripts/smoke-live-packs.mjs",
    "deploy:backend": "npm --prefix backend run deploy:all",
    "sync:i18n": "node scripts/sync-i18n-missing-from-en.mjs",
    "apply:i18n": "node scripts/apply-i18n-translations.mjs"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.31",
    "@clerk/expo-passkeys": "^1.0.6",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/schibsted-grotesk": "^0.4.2",
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo-google-fonts/spline-sans-mono": "^0.4.2",
    "@expo-google-fonts/zen-kaku-gothic-new": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.6",
    "@react-navigation/native": "^7.1.34",
    "@react-navigation/stack": "^7.8.6",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.99.3",
    "expo": "~54.0.36",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-localization": "~17.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "gsap": "^3.15.0",
    "i18next": "^25.10.2",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^16.6.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.15.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.17",
    "three": "^0.184.0",
    "viem": "^2.52.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.0",
    "@types/three": "^0.184.1",
    "@vitalets/google-translate-api": "^9.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "supabase": "^2.105.0",
    "typescript": "~5.9.2",
    "vite": "^6.4.1"
  },
  "private": true
}
