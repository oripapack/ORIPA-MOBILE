# Copy to backend/.env (gitignored). Used by Supabase CLI for LOCAL dev only (`npm run start`).
#
# You do NOT put the Clerk publishable key (pk_test_...) here — that lives in the ROOT .env
# for the Expo app. This file only needs your Clerk *domain* for local config.toml.
#
# How to find CLERK_DOMAIN:
#   1. https://dashboard.clerk.com → your app
#   2. Configure → Supabase integration (or https://clerk.com/setup/supabase)
#   3. Copy the domain, e.g. credible-bear-63.clerk.accounts.dev
#
# For HOSTED Supabase (akfxxfthwpylpwdnjzcy): set the same domain in
# Dashboard → Authentication → Sign In / Providers → Clerk (not in this file).

CLERK_DOMAIN=your-instance.clerk.accounts.dev
