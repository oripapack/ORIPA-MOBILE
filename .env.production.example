# Copy to `.env.production`, replace every placeholder, and keep that file out of Git.
# EXPO_PUBLIC_* values are embedded in the client and must never contain server secrets.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your-production-key

# HTTPS origin that serves opening-3d.html. Do not include the file name.
EXPO_PUBLIC_PACK_RING_WEB_URL=https://opening.pullhub.app

# Public legal identity and URLs embedded in the App Store build. These are not secrets.
# Use the exact legal entity that owns and operates the service.
EXPO_PUBLIC_LEGAL_ENTITY_NAME=Your Legal Entity Name
EXPO_PUBLIC_LEGAL_CONTACT_EMAIL=privacy@pullhub.app
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://pullhub.com/privacy
EXPO_PUBLIC_SUPPORT_URL=https://pullhub.com/support

# Enable a surface only after its production backend and operations are verified.
EXPO_PUBLIC_MARKETPLACE_LIVE=0
EXPO_PUBLIC_PROMOTIONS_LIVE=0
EXPO_PUBLIC_MEMBERSHIP_LIVE=0
EXPO_PUBLIC_SOCIAL_LIVE=0
EXPO_PUBLIC_SHIPPING_LIVE=0
EXPO_PUBLIC_ADVANCED_ACCOUNT_SERVICES_LIVE=0
EXPO_PUBLIC_SUPPORT_LIVE=0
