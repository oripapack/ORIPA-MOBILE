# Committed template for production EAS env. Copy to `.env.production` and fill real values.
# Or set the same keys as EAS project secrets before `eas build --profile production`.

EXPO_PUBLIC_SUPABASE_URL=https://your-proj.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your_key

# HTTPS origin that serves opening-3d.html (no trailing path — the app appends /opening-3d.html).
EXPO_PUBLIC_PACK_RING_WEB_URL=https://your-hosted-web-domain.com
