# Clerk Dashboard → API Keys:
#   - Publishable key → NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY (same pk_test_… as root .env)
#   - Secret key      → CLERK_SECRET_KEY (sk_test_… — server only, NOT in Expo .env)
#
# Supabase: same project as root .env (EXPO_PUBLIC_* → NEXT_PUBLIC_*)

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
