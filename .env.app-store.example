# Copy to `.env.app-store.local`. That file is ignored by Git.
# This file contains submission declarations and review details, never passwords.

APP_STORE_ASC_APP_ID=0000000000
APP_STORE_EAS_BUILD_ID=
APP_STORE_TESTFLIGHT_BUILD_NUMBER=
APP_STORE_LEGAL_ENTITY_NAME=Your Legal Entity Name
APP_STORE_PRIVACY_URL=https://pullhub.com/privacy
APP_STORE_SUPPORT_URL=https://pullhub.com/support
APP_STORE_SUPPORT_CONTACT_EMAIL=support@pullhub.app
APP_STORE_RELEASE_COUNTRIES=US
APP_STORE_REVIEW_CONTACT_FIRST_NAME=
APP_STORE_REVIEW_CONTACT_LAST_NAME=
APP_STORE_REVIEW_CONTACT_EMAIL=
APP_STORE_REVIEW_CONTACT_PHONE=

# Never store the review password in this file or repository.
APP_STORE_REVIEW_ACCOUNT_EMAIL=reviewer@example.com
APP_STORE_REVIEW_ACCOUNT_READY=no
APP_STORE_REVIEW_PACK_ID=live-pack-id
APP_STORE_POINTS_PRODUCT_IDS=com.pullhub.points.small,com.pullhub.points.large
APP_STORE_REVIEW_OPEN_NAVIGATION=Home > Live pack > Open pack
APP_STORE_ODDS_NAVIGATION=Home > Pack > View odds
APP_STORE_FAIRNESS_NAVIGATION=Vault > Pull record > Fairness record
APP_STORE_VAULT_TRADE_IN_NAVIGATION=Vault > Eligible pull > Trade in
APP_STORE_SHIPPING_LIMITATIONS=Describe eligible U.S. regions and unavailable regions
APP_STORE_ACCOUNT_DELETION_NAVIGATION=Account > Settings > Account deletion > Delete account
APP_STORE_CHANCE_MODEL_SUMMARY=Unresolved pending legal review

# Each approval must be changed to yes only after the named owner actually signs off.
APP_STORE_LEGAL_COPY_APPROVED=no
APP_STORE_CHANCE_MODEL_LEGAL_APPROVED=no
APP_STORE_AGE_RATING_LOOT_BOXES=yes
APP_STORE_AGE_RATING_GAMBLING=unresolved
APP_STORE_AGE_RATING_SIMULATED_GAMBLING=unresolved
APP_STORE_PRIVACY_VENDOR_AUDIT_APPROVED=no
APP_STORE_ACCOUNT_DELETION_DEPLOYED=no
APP_STORE_SIWA_REVOCATION_VERIFIED=no
APP_STORE_IAP_VERIFIED=no
APP_STORE_FAIRNESS_INVENTORY_VERIFIED=no
APP_STORE_CORE_FLOW_SMOKE_PASSED=no
APP_STORE_TESTFLIGHT_QA_PASSED=no
