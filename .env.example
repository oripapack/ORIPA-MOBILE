# Copy to `.env` for local Expo (never commit real secrets).

# Clerk (mobile app sign-in) — https://dashboard.clerk.com → API Keys → Publishable key
# NOT the secret key. NOT the Clerk domain (domain goes in Supabase Dashboard + backend/.env).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Supabase — Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Native pack ring animation (WebView) — run `npm run prototype:web`, then set:
# EXPO_PUBLIC_PACK_RING_WEB_URL=http://localhost:3000/sandbox/pack-opening
# On a physical device use your machine's LAN IP instead of localhost.
EXPO_PUBLIC_PACK_RING_WEB_URL=
