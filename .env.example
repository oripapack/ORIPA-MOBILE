# Copy to `.env` for local Expo (never commit real secrets).

# Clerk (mobile app sign-in) — https://dashboard.clerk.com → API Keys → Publishable key
# NOT the secret key. NOT the Clerk domain (domain goes in Supabase Dashboard + backend/.env).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Supabase — Project Settings → API
# Use the legacy anon JWT (eyJ…), not sb_publishable_… (REST returns 401 on publishable keys).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional Stripe (credit top-up Checkout). Use the *publishable* key (pk_live_… / pk_test_…).
# Server also needs STRIPE_SECRET_KEY on create-credit-checkout + stripe-webhook edge functions.
# Leave empty until Checkout is ready — client shows “coming soon” when unset.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Set to 1 to allow Stripe Checkout for credits on iOS/Android (non-store testing only).
# Production App Store / Play builds should leave this unset and use IAP when available.
# EXPO_PUBLIC_ALLOW_NATIVE_STRIPE_CREDITS=1

# Native / web 3D pack opening scene origin (HTTPS in production).
# Dev: leave empty for auto LAN (:3000) or set e.g. http://192.168.11.14:3000
# Production EAS: required HTTPS host serving opening-3d.html, or the app uses TerminalOpeningFallback.
EXPO_PUBLIC_PACK_RING_WEB_URL=

# Dev-only initial route override (UiGallery | Result). Ignored when __DEV__ is false.
# EXPO_PUBLIC_DEV_SCREEN=
