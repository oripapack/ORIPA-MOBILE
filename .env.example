# Copy to `.env` for local Expo (never commit real secrets).

# Clerk (mobile app sign-in) — https://dashboard.clerk.com → API Keys → Publishable key
# NOT the secret key. NOT the Clerk domain (domain goes in Supabase Dashboard + backend/.env).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Supabase — Project Settings → API
# Use the legacy anon JWT (eyJ…), not sb_publishable_… (REST returns 401 on publishable keys).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Native 3D pack ring (WebView). `npm start` runs Expo + Vite scene server on port 3000.
# Physical device example: http://192.168.11.14:3000
EXPO_PUBLIC_PACK_RING_WEB_URL=

# Release gates. Keep each value unset until its provider, server-owned data,
# failure/recovery path, and production operations are verified end to end.
EXPO_PUBLIC_MARKETPLACE_LIVE=
EXPO_PUBLIC_PROMOTIONS_LIVE=
EXPO_PUBLIC_MEMBERSHIP_LIVE=
EXPO_PUBLIC_SOCIAL_LIVE=
EXPO_PUBLIC_SHIPPING_LIVE=
EXPO_PUBLIC_SUPPORT_LIVE=
EXPO_PUBLIC_ADVANCED_ACCOUNT_SERVICES_LIVE=
